# SOC Triage Agent — environment template
# Copy to .env for local experiments. Never commit .env.
#
# The rules-only path is the default. Import, tests, and the future
# `soc-triage run` demo do not need any of the values below.

# Optional LLM note enrichment (T7). Leave unset to keep template notes.
# SOC_TRIAGE_LLM_ENABLED=0
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# SOC_TRIAGE_LLM_MODEL=
