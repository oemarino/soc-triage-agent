# SOC Triage Agent — environment template
# Copy to .env for local experiments. Never commit .env.
#
# The rules-only path is the default. Import, tests, soc-triage run,
# and soc-triage eval do not read these values and do not make network calls.
# soc-triage run --llm-notes reads a .env in the working directory, then
# the process environment. The process environment wins.

# none (default) or openai_compatible
# SOC_TRIAGE_LLM_PROVIDER=none

# API root ending in /v1. The client appends /chat/completions.
# SOC_TRIAGE_LLM_BASE_URL=
# SOC_TRIAGE_LLM_MODEL=

# Bearer token. Leave unset for a local Ollama server. Never commit a real key.
# SOC_TRIAGE_LLM_API_KEY=

# Seconds. Default 8. Values outside (0, 60] are ignored.
# SOC_TRIAGE_LLM_TIMEOUT=8

# xAI Grok
# SOC_TRIAGE_LLM_PROVIDER=openai_compatible
# SOC_TRIAGE_LLM_BASE_URL=https://api.x.ai/v1
# SOC_TRIAGE_LLM_MODEL=grok-4
# SOC_TRIAGE_LLM_API_KEY=

# OpenAI
# SOC_TRIAGE_LLM_PROVIDER=openai_compatible
# SOC_TRIAGE_LLM_BASE_URL=https://api.openai.com/v1
# SOC_TRIAGE_LLM_MODEL=gpt-4o-mini
# SOC_TRIAGE_LLM_API_KEY=

# Local Ollama (no key)
# SOC_TRIAGE_LLM_PROVIDER=openai_compatible
# SOC_TRIAGE_LLM_BASE_URL=http://localhost:11434/v1
# SOC_TRIAGE_LLM_MODEL=llama3.2
# SOC_TRIAGE_LLM_API_KEY=
